# ============================================================
# Environment Variables for saraplatformapi
# Copy this file to .env.development, .env.production, or .env.test
# and fill in the actual values.
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/saraplatform

# JWT Authentication
JWT_SECRET=your-super-secret-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Auth Cookie
COOKIE_NAME=auth_token

# Frontend & Backend URLs
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# CORS
CORS_ORIGINS=http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50

# Body Size Limits
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb

# Email (Brevo)
BREVO_API_KEY=your-brevo-api-key
EMAIL_SENDER_NAME=Your App Name
EMAIL_SENDER_EMAIL=noreply@yourdomain.com

# Email Retry Config
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_DELAY_MS=1000
EMAIL_QUEUE_POLL_INTERVAL_MS=10000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# AI CV Processing
# Gemini (free tier, no credit card required)
GEMINI_API_KEY=your-gemini-api-key
# Groq (free tier, no credit card required — Llama, Mixtral models)
GROQ_API_KEY=your-groq-api-key
# Mistral (free tier, no credit card required)
MISTRAL_API_KEY=your-mistral-api-key
