        <!-- Extracción de Características -->
        <mxCell id="feature-extraction" value="&lt;b&gt;Extracción de Características&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Normalización de datos&lt;br&gt;• Identificación de patrones&lt;br&gt;• Cálculo de métricas&lt;br&gt;• Vectorización de atributos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF59D;strokeColor=#F9A825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=10;" vertex="1" parent="1">
