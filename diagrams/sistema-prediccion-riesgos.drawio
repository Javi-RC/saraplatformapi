          </mxGeometry>
        </mxCell>
        
        <!-- CAPA 3: MOTORES DE PREDICCIÓN -->
        <mxCell id="layer3-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="1080" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="layer3-title" value="&lt;b&gt;CAPA 3: MOTORES DE PREDICCIÓN (HÍBRIDO)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="50" y="395" width="350" height="20" as="geometry" />
        </mxCell>
        
        <!-- Motor de Reglas Expertas -->
        <mxCell id="expert-rules-engine" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="425" width="440" height="125" as="geometry" />
        </mxCell>
        
        <mxCell id="expert-title" value="&lt;b&gt;Motor de Reglas Expertas (Decision Tree)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="90" y="430" width="300" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="expert-content" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;8 Tipos de Riesgos Analizados:&lt;/b&gt;&lt;br&gt;1. Fallos de comunicación (communication_breakdown)&lt;br&gt;2. Brechas de competencias (skill_gap)&lt;br&gt;3. Sobrecarga del equipo (team_overload)&lt;br&gt;4. Bloqueos de dependencias (dependency_blockage)&lt;br&gt;5. Expansión de alcance (scope_creep)&lt;br&gt;6. Conflictos de proceso (process_mismatch)&lt;br&gt;7. Infraestructura técnica (technical_infrastructure)&lt;br&gt;8. Degradación de calidad (quality_degradation)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="90" y="455" width="420" height="85" as="geometry" />
        </mxCell>
        
        <mxCell id="weight-indicator-1" value="&lt;b&gt;Peso: 90%-30%&lt;/b&gt;&lt;br&gt;(según fase)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=#2E7D32;fontSize=9;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="390" y="427" width="120" height="30" as="geometry" />
        </mxCell>
        
        <!-- Motor CBR -->
        <mxCell id="cbr-engine" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="425" width="540" height="125" as="geometry" />
        </mxCell>
        
        <mxCell id="cbr-title" value="&lt;b&gt;Motor de Razonamiento Basado en Casos (CBR)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="570" y="430" width="350" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="cbr-content" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Ciclo de las 4Rs:&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. RETRIEVE (Recuperar):&lt;/b&gt; Búsqueda de casos similares mediante cálculo de distancia multidimensional&lt;br&gt;&lt;b&gt;2. REUSE (Reutilizar):&lt;/b&gt; Adaptación de soluciones de casos históricos al contexto actual&lt;br&gt;&lt;b&gt;3. REVISE (Revisar):&lt;/b&gt; Validación con reglas expertas y ajuste de predicciones&lt;br&gt;&lt;b&gt;4. RETAIN (Retener):&lt;/b&gt; Incorporación de nuevos casos tras finalización de proyectos&lt;br&gt;&lt;br&gt;&lt;b&gt;Fuentes de casos:&lt;/b&gt; Históricos organizacionales (peso 1.0) + Casos semilla de literatura (peso 0.6)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="570" y="455" width="520" height="85" as="geometry" />
        </mxCell>
        
        <mxCell id="weight-indicator-2" value="&lt;b&gt;Peso: 10%-70%&lt;/b&gt;&lt;br&gt;(según fase)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;strokeColor=#2E7D32;fontSize=9;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="970" y="427" width="120" height="30" as="geometry" />
        </mxCell>
        
