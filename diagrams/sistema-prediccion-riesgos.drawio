        </mxCell>
        
        <!-- Análisis de Similaridad -->
        <mxCell id="similarity-analysis" value="&lt;b&gt;Análisis Multidimensional&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Dimensión de coordinación (25%)&lt;br&gt;• Dimensión técnica (30%)&lt;br&gt;• Dimensión de equipo (20%)&lt;br&gt;• Dimensión de gestión (15%)&lt;br&gt;• Dimensión organizacional (10%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF59D;strokeColor=#F9A825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="285" width="260" height="60" as="geometry" />
        </mxCell>
        
