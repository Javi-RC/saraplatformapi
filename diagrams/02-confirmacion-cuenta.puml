@startuml 02_Confirmacion_Cuenta
!theme plain
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam noteFontSize 9
skinparam participantFontSize 10

title Diagrama de Secuencia 2/4: Confirmación de Cuenta\n(TFG - Sistema de Gestión de CVs)

' ============================================
' PARTICIPANTES
' ============================================
actor Usuario as U #LightBlue
box "Cliente Email" #LightGray
    participant "Gmail/Outlook" as MAIL
end box
participant "<<Frontend>>\nConfirmAccount" as UI #LightGreen
participant "<<Backend>>\nauth.routes" as AR #LightYellow
participant "<<Backend>>\nauth.controller" as CTRL #LightYellow
participant "<<Backend>>\nauth.service" as SVC #LightYellow
participant "<<Database>>\nMongoDB" as DB #LightCoral

note over U, DB #E8F5E9
  **Prerrequisito:** Usuario registrado en 01-registro-usuario.puml
  Email recibido con link: ${BACKEND_URL}/auth/confirm?token=xxx
end note

' ============================================
' FLUJO DE CONFIRMACIÓN
' ============================================
U -> MAIL: Abre bandeja de entrada
activate MAIL
MAIL --> U: Email "Confirma tu cuenta"

U -> MAIL: Click en botón/enlace
MAIL -> AR: GET /auth/confirm?token=xxx
deactivate MAIL

activate AR
AR -> CTRL: confirmAccount(req, res)
activate CTRL

alt #Pink Token no proporcionado
    CTRL --> AR: redirect(/error)
    AR --> UI: HTTP 302 → /error
    deactivate CTRL
    deactivate AR
    activate UI
    UI --> U: "Token inválido"
    deactivate UI
else #LightGreen Token proporcionado
    CTRL -> SVC: confirmAccount(token)
    activate SVC
    
    SVC -> DB: findOne({\n  confirmationToken: token,\n  confirmationTokenExpiry: { $gt: now }\n})
    activate DB
    DB --> SVC: user | null
    deactivate DB
    
    alt #Pink Token inválido o expirado
        SVC --> CTRL: throw INVALID_OR_EXPIRED_TOKEN
        deactivate SVC
        CTRL --> AR: redirect(/error)
        AR --> UI: HTTP 302 → /error
        deactivate CTRL
        deactivate AR
        activate UI
        UI --> U: "Token inválido o expirado"
        note right of UI #FFCCCC
          Usuario debe solicitar
          nuevo email de confirmación
        end note
        deactivate UI
    else #LightGreen Token válido
        SVC -> SVC: user.isConfirmed = true
        SVC -> SVC: user.confirmationToken = undefined
        SVC -> SVC: user.confirmationTokenExpiry = undefined
        SVC -> SVC: user.lastLogin = new Date()
        
        SVC -> DB: user.save()
        activate DB
        DB --> SVC: OK
        deactivate DB
        
        SVC --> CTRL: user (confirmado)
        deactivate SVC
        
        CTRL --> AR: redirect(/login?confirmed=true)
        AR --> UI: HTTP 302 → /login?confirmed=true
        deactivate CTRL
        deactivate AR
        
        activate UI
        UI --> U: Página Login con mensaje:\n"Cuenta confirmada.\nYa puedes iniciar sesión."
        note right of UI #LightGreen
          Query param confirmed=true
          activa toast de éxito
        end note
        deactivate UI
    end
end

note over U, DB #FFFFCC
  **Continúa en:** 03-login-usuario.puml
end note

@enduml
