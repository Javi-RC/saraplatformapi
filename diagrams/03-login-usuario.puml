@startuml 03_Login_Usuario
!theme plain
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam noteFontSize 9
skinparam participantFontSize 10

title Diagrama de Secuencia 3/4: Login de Usuario\n(TFG - Sistema de Gestión de CVs)

' ============================================
' PARTICIPANTES
' ============================================
actor Usuario as U #LightBlue
participant "<<Frontend>>\nLogin.jsx" as UI #LightGreen
participant "<<Frontend>>\nAuthContext" as AC #LightGreen
participant "<<Backend>>\nauth.routes" as AR #LightYellow
participant "<<Backend>>\nauth.controller" as CTRL #LightYellow
participant "<<Backend>>\nvalidators" as VAL #Orange
participant "<<Backend>>\nauth.service" as SVC #LightYellow
participant "<<Database>>\nMongoDB" as DB #LightCoral

note over U, DB #E8F5E9
  **Prerrequisito:** Cuenta confirmada en 02-confirmacion-cuenta.puml
end note

' ============================================
' FLUJO DE LOGIN
' ============================================
U -> UI: Accede a /login
activate UI
UI --> U: Muestra formulario

U -> UI: Ingresa email y password
UI -> AC: login({ email, password })
activate AC

note over AC #LightBlue
  POST /auth/login
  Content-Type: application/json
  Body: { email, password }
end note

AC -> AR: POST /auth/login
activate AR
AR -> CTRL: login(req, res)
activate CTRL

CTRL -> VAL: validateLoginData()
activate VAL

alt #Pink Datos faltantes
    VAL --> CTRL: throw MISSING_CREDENTIALS
    deactivate VAL
    CTRL --> AR: HTTP 400
    AR --> AC: 400 Bad Request
    deactivate CTRL
    deactivate AR
    AC --> UI: reject(error)
    deactivate AC
    UI --> U: "Email y contraseña requeridos"
else #LightGreen Datos presentes
    VAL --> CTRL: OK
    deactivate VAL
    
    CTRL -> SVC: login({ email, password })
    activate SVC
    
    SVC -> DB: findOne({ email }).select('+passwordHash')
    activate DB
    DB --> SVC: user | null
    deactivate DB
    
    alt #Pink Usuario no existe
        SVC --> CTRL: throw INVALID_CREDENTIALS
        deactivate SVC
        CTRL --> AR: HTTP 401
        AR --> AC: 401 Unauthorized
        deactivate CTRL
        deactivate AR
        AC --> UI: reject(error)
        deactivate AC
        UI --> U: "Credenciales inválidas"
    else #LightGreen Usuario existe
        
        alt #Pink Email no confirmado
            SVC --> CTRL: throw EMAIL_NOT_CONFIRMED
            deactivate SVC
            CTRL --> AR: HTTP 401
            AR --> AC: 401 Unauthorized
            deactivate CTRL
            deactivate AR
            AC --> UI: reject(error)
            deactivate AC
            UI --> U: "Confirma tu email primero"
        else #LightGreen Email confirmado
            
            SVC -> SVC: bcrypt.compare(password, hash)
            
            alt #Pink Password incorrecto
                SVC --> CTRL: throw INVALID_CREDENTIALS
                deactivate SVC
                CTRL --> AR: HTTP 401
                AR --> AC: 401 Unauthorized
                deactivate CTRL
                deactivate AR
                AC --> UI: reject(error)
                deactivate AC
                UI --> U: "Credenciales inválidas"
            else #LightGreen Password correcto
                SVC -> SVC: user.lastLogin = new Date()
                
                SVC -> DB: user.save()
                activate DB
                DB --> SVC: OK
                deactivate DB
                
                SVC -> SVC: generateToken(user)
                note right of SVC #LightCyan
                  **JWT Payload:**
                  { userId, email, name, role }
                  Expira: 7 días
                end note
                
                SVC --> CTRL: { token, user }
                deactivate SVC
                
                CTRL --> AR: HTTP 200 { token, user }
                AR --> AC: 200 OK
                deactivate CTRL
                deactivate AR
                
                AC -> AC: setSession(token, user)
                note right of AC #LightCyan
                  localStorage.setItem('token', token)
                  localStorage.setItem('user', JSON.stringify(user))
                end note
                
                AC --> UI: resolve({ token, user })
                deactivate AC
                
                alt #LightYellow role === 'unassigned'
                    UI --> U: Redirect /complete-profile
                    note right of UI: Usuario OAuth\nsin rol definido
                else #LightGreen role definido
                    UI --> U: Redirect / (Dashboard)
                end
            end
        end
    end
end

deactivate UI

note over U, DB #FFFFCC
  **Continúa en:** 04-carga-perfil.puml
end note

@enduml
