@startuml 04_Carga_Perfil
!theme plain
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam noteFontSize 9
skinparam participantFontSize 10

title Diagrama de Secuencia 4/4: Carga de Perfil y Rutas Protegidas\n(TFG - Sistema de Gestión de CVs)

' ============================================
' PARTICIPANTES
' ============================================
actor Usuario as U #LightBlue
participant "<<Frontend>>\nProtectedRoute" as PR #LightGreen
participant "<<Frontend>>\nAuthProvider" as AP #LightGreen
participant "<<Frontend>>\nAPI Client" as AC #LightGreen
participant "<<Backend>>\nauth.routes" as AR #LightYellow
participant "<<Backend>>\njwt.js" as JWT #Orange
participant "<<Database>>\nMongoDB" as DB #LightCoral

note over U, DB #E8F5E9
  **Prerrequisito:** Login exitoso en 03-login-usuario.puml
  Token JWT almacenado en localStorage
end note

' ============================================
' FLUJO: NAVEGACIÓN A RUTA PROTEGIDA
' ============================================
== Acceso a Ruta Protegida ==

U -> PR: Navega a /dashboard
activate PR

PR -> PR: Verifica token en localStorage

alt #Pink No hay token
    PR --> U: Redirect /login
    note right of PR #FFCCCC: ProtectedRoute\nbloquea acceso
else #LightGreen Token existe
    PR -> AP: Solicita perfil de usuario
    activate AP
    
    AP -> AC: loadProfile()
    activate AC
    
    note over AC #LightBlue
      GET /api/profile
      Authorization: Bearer <token>
    end note
    
    AC -> AR: GET /api/profile
    activate AR
    
    AR -> JWT: authMiddleware(req, res, next)
    activate JWT
    
    JWT -> JWT: Extrae token del header
    JWT -> JWT: jwt.verify(token, JWT_SECRET)
    
    alt #Pink Token inválido
        JWT --> AR: throw "Token inválido"
        deactivate JWT
        AR --> AC: HTTP 401 { error: "Token inválido" }
        deactivate AR
        AC -> AC: localStorage.removeItem('token')
        AC -> AC: localStorage.removeItem('user')
        AC --> AP: null
        deactivate AC
        AP --> PR: user = null
        deactivate AP
        PR --> U: Redirect /login
    else #Pink Token expirado
        JWT --> AR: throw "Token expirado"
        deactivate JWT
        AR --> AC: HTTP 401 { error: "Token expirado" }
        deactivate AR
        AC -> AC: Limpia localStorage
        AC --> AP: null
        deactivate AC
        AP --> PR: user = null
        deactivate AP
        PR --> U: Redirect /login
    else #LightGreen Token válido
        JWT -> JWT: Adjunta decoded a req.user
        JWT --> AR: next()
        deactivate JWT
        
        AR -> DB: User.findById(req.user.userId)
        activate DB
        DB --> AR: user
        deactivate DB
        
        AR --> AC: HTTP 200 { user }
        deactivate AR
        AC --> AP: user
        deactivate AC
        
        AP -> AP: setUser(user)
        AP --> PR: user (cargado)
        deactivate AP
        
        PR --> U: Renderiza contenido protegido
    end
end

deactivate PR

' ============================================
' FLUJO: COMPLETE PROFILE (rol unassigned)
' ============================================
== Completar Perfil (OAuth / rol unassigned) ==

U -> PR: Navega a /complete-profile
activate PR

note over PR #LightYellow
  Ruta para usuarios OAuth
  que no tienen rol asignado
end note

PR -> AP: Verifica sesión
activate AP
AP --> PR: user.role === 'unassigned'
deactivate AP

PR --> U: Muestra formulario de rol
deactivate PR

U -> AC: Selecciona rol (employee | org_admin)
activate AC

note over AC #LightBlue
  PUT /auth/profile
  Authorization: Bearer <token>
  Body: { role: "employee" }
end note

AC -> AR: PUT /auth/profile { role }
activate AR

AR -> JWT: authMiddleware()
activate JWT
JWT --> AR: req.user = decoded
deactivate JWT

AR -> DB: User.findById(userId)
activate DB
DB --> AR: user
deactivate DB

AR -> AR: user.role = role
AR -> DB: user.save()
activate DB
DB --> AR: OK
deactivate DB

AR --> AC: HTTP 200 { user }
deactivate AR

AC -> AC: Actualiza localStorage
AC --> U: Redirect / (Dashboard)
deactivate AC

' ============================================
' NOTAS FINALES
' ============================================
note over U, DB #FFFFCC
  **Resumen de Seguridad:**
  • JWT firmado con HS256
  • Token expira en 7 días
  • authMiddleware valida en cada request
  • Frontend limpia sesión si token inválido
end note

note over U, DB #E8F5E9
  **Flujo Completo:**
  1. 01-registro-usuario.puml
  2. 02-confirmacion-cuenta.puml
  3. 03-login-usuario.puml
  4. 04-carga-perfil.puml (este)
end note

@enduml
