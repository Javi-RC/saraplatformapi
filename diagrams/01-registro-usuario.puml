@startuml 01_Registro_Usuario
!theme plain
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam noteFontSize 9
skinparam participantFontSize 10

title Diagrama de Secuencia 1/4: Registro de Usuario\n(TFG - Sistema de Gestión de CVs)

' ============================================
' PARTICIPANTES
' ============================================
actor Usuario as U #LightBlue
participant "<<Frontend>>\nRegister.jsx" as UI #LightGreen
participant "<<Frontend>>\nAPI Client" as AC #LightGreen
participant "<<Backend>>\nauth.routes" as AR #LightYellow
participant "<<Backend>>\nauth.controller" as CTRL #LightYellow
participant "<<Backend>>\nvalidators" as VAL #Orange
participant "<<Backend>>\nauth.service" as SVC #LightYellow
participant "<<Database>>\nMongoDB" as DB #LightCoral
participant "<<External>>\nBrevo API" as EMAIL #LightPink

' ============================================
' FLUJO PRINCIPAL
' ============================================
U -> UI: Accede a /register
activate UI
UI --> U: Muestra Stepper (Paso 1)

note over UI #LightCyan
  **Validación Cliente:**
  Paso 1: username ≥3 chars, role
  Paso 2: password (8+, mayús, minús, num, especial)
  Paso 3: email regex, name
end note

U -> UI: Completa los 3 pasos
UI -> UI: Valida datos localmente

alt #Pink Validación Cliente FALLA
    UI --> U: Error inline (no navega)
else #LightGreen Validación Cliente OK
    UI -> AC: handleSubmit()
    activate AC
    
    AC -> AR: POST /auth/register\n{ email, name, password, role }
    activate AR
    AR -> CTRL: register(req, res)
    activate CTRL
    
    CTRL -> VAL: validateRegistrationData()
    activate VAL
    
    alt #Pink Validación Backend FALLA
        VAL --> CTRL: throw Error
        deactivate VAL
        CTRL --> AR: HTTP 400 { error }
        AR --> AC: 400 Bad Request
        deactivate CTRL
        deactivate AR
        AC --> UI: reject(error)
        deactivate AC
        UI --> U: Muestra error backend
    else #LightGreen Validación OK
        VAL --> CTRL: OK
        deactivate VAL
        
        CTRL -> SVC: register(userData)
        activate SVC
        
        SVC -> DB: findOne({ email })
        activate DB
        DB --> SVC: user | null
        deactivate DB
        
        alt #Pink Email duplicado
            SVC --> CTRL: throw USER_ALREADY_EXISTS
            deactivate SVC
            CTRL --> AR: HTTP 409
            AR --> AC: 409 Conflict
            deactivate CTRL
            deactivate AR
            AC --> UI: reject(error)
            deactivate AC
            UI --> U: "Email ya registrado"
        else #LightGreen Email disponible
            SVC -> SVC: bcrypt.hash(password, 12)
            SVC -> SVC: crypto.randomBytes(32)
            
            SVC -> DB: User.save()
            activate DB
            DB --> SVC: newUser
            deactivate DB
            
            SVC ->> EMAIL: sendConfirmationEmail()
            activate EMAIL
            note right of EMAIL: Async: envía link\ncon token (expira 24h)
            EMAIL --> SVC: OK
            deactivate EMAIL
            
            SVC --> CTRL: { user, message }
            deactivate SVC
            
            CTRL --> AR: HTTP 201 { success, user }
            AR --> AC: 201 Created
            deactivate CTRL
            deactivate AR
            AC --> UI: resolve(data)
            deactivate AC
            
            UI --> U: "Cuenta creada.\nRevisa tu email"
            note right of UI #LightGreen: Muestra botón\n"Reenviar email"
        end
    end
end

deactivate UI

' ============================================
' REENVÍO DE EMAIL
' ============================================
== Reenvío de Email (Opcional) ==

U -> UI: Click "Resend email"
activate UI
UI -> AC: resendConfirmation()
activate AC

AC -> AR: POST /auth/send-confirmation
activate AR
AR -> CTRL: sendConfirmation()
activate CTRL

CTRL -> SVC: resendConfirmationEmail()
activate SVC

SVC -> DB: findOne + update token
activate DB
DB --> SVC: OK
deactivate DB

SVC ->> EMAIL: sendConfirmationEmail()
activate EMAIL
EMAIL --> SVC: OK
deactivate EMAIL

SVC --> CTRL: { message }
deactivate SVC
CTRL --> AR: HTTP 200
AR --> AC: OK
deactivate CTRL
deactivate AR
AC --> UI: resolve
deactivate AC
UI --> U: "Email reenviado"

deactivate UI

note over U, EMAIL #FFFFCC
  **Continúa en:** 02-confirmacion-cuenta.puml
end note

@enduml
