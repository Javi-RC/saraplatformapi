@startuml 01_Registro_Usuario
!theme plain
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam noteFontSize 9
skinparam participantFontSize 10

title Diagrama de Secuencia 1/4: Registro de Usuario\n(TFG - Sistema de Gestión de CVs)

' ============================================
' PARTICIPANTES
' ============================================
actor Usuario as U #LightBlue
participant "<<Frontend>>\nRegister.jsx" as UI #LightGreen
participant "<<Frontend>>\nAPI Client" as AC #LightGreen
participant "<<Backend>>\nauth.routes" as AR #LightYellow
participant "<<Backend>>\nauth.controller" as CTRL #LightYellow
participant "<<Backend>>\nvalidators" as VAL #Orange
participant "<<Backend>>\nauth.service" as SVC #LightYellow
participant "<<Database>>\nMongoDB" as DB #LightCoral
participant "<<External>>\nBrevo API" as EMAIL #LightPink

' ============================================
' FLUJO PRINCIPAL
' ============================================
U -> UI: Accede a /register
activate UI
UI --> U: Muestra Stepper (Paso 1)

note over UI #LightCyan
  **Validación Cliente:**
  Paso 1: username ≥3 chars, role
  Paso 2: password (8+, mayús, minús, num, especial)
  Paso 3: email regex, name
end note

U -> UI: Completa los 3 pasos
UI -> UI: Valida datos localmente

alt #Pink Validación Cliente FALLA
    UI --> U: Error inline (no navega)
else #LightGreen Validación Cliente OK
    UI -> AC: handleSubmit()
    activate AC
    
    AC -> AR: POST /auth/register\n{ email, name, password, role }
    activate AR
    AR -> CTRL: register(req, res)
    activate CTRL
    
    CTRL -> VAL: validateRegistrationData()
    activate VAL
    
    alt #Pink Validación Backend FALLA
        VAL --> CTRL: throw Error
        deactivate VAL
        CTRL --> AR: HTTP 400 { error }
        AR --> AC: 400 Bad Request
        deactivate CTRL
        deactivate AR
        AC --> UI: reject(error)
        deactivate AC
        UI --> U: Muestra error backend
    else #LightGreen Validación OK
        VAL --> CTRL: OK
        deactivate VAL
        
        CTRL -> SVC: register(userData)
        activate SVC
        
        SVC -> DB: findOne({ email })
        activate DB
        DB --> SVC: user | null
        deactivate DB
        
        alt #Pink Email ya verificado
            note right of SVC: Usuario existe\ny isConfirmed=true
            SVC --> CTRL: throw USER_ALREADY_EXISTS
            deactivate SVC
            CTRL --> AR: HTTP 409
            AR --> AC: 409 Conflict
            deactivate CTRL
            deactivate AR
            AC --> UI: reject(error)
            deactivate AC
            UI --> U: "Email ya registrado y verificado"
        else #Orange Email existe pero NO verificado
            note right of SVC: Usuario existe pero\nisConfirmed=false
            SVC -> SVC: Verificar verificationTokenExpiry
            
            alt #LightCoral Token expirado (>24h)
                note right of SVC: Permitir re-registro:\neliminar usuario anterior
                SVC -> DB: deleteOne({ _id })
                activate DB
                DB --> SVC: OK
                deactivate DB
                
                note right of SVC: Continúa con\nregistro normal
                SVC -> SVC: bcrypt.hash(password, 12)
                SVC -> SVC: crypto.randomBytes(32)
                
                SVC -> DB: User.save()
                activate DB
                DB --> SVC: newUser
                deactivate DB
                
                SVC ->> EMAIL: sendConfirmationEmail()
                activate EMAIL
                note right of EMAIL: Envía nuevo link\ncon token (expira 24h)
                EMAIL --> SVC: OK
                deactivate EMAIL
                
                SVC --> CTRL: { user, message }
                deactivate SVC
                
                CTRL --> AR: HTTP 201 { success, user }
                AR --> AC: 201 Created
                deactivate CTRL
                deactivate AR
                AC --> UI: resolve(data)
                deactivate AC
                
                UI --> U: "Cuenta creada.\nRevisa tu email"
            else #LightYellow Token válido (<24h)
                SVC -> SVC: Verificar registrationAttempts
                
                alt #Pink Límite alcanzado (≥3)
                    note right of SVC: Demasiados intentos
                    SVC --> CTRL: throw TOO_MANY_ATTEMPTS
                    deactivate SVC
                    CTRL --> AR: HTTP 429
                    AR --> AC: 429 Too Many Requests
                    deactivate CTRL
                    deactivate AR
                    AC --> UI: reject(error)
                    deactivate AC
                    UI --> U: "Demasiados intentos.\nEspera 24h"
                else #LightGreen Intentos disponibles (<3)
                    note right of SVC: Reenviar email\ny aumentar contador
                    SVC -> SVC: Nuevo token + incrementar attempts
                    
                    SVC -> DB: save() + update
                    activate DB
                    DB --> SVC: OK
                    deactivate DB
                    
                    SVC ->> EMAIL: sendConfirmationEmail()
                    activate EMAIL
                    EMAIL --> SVC: OK
                    deactivate EMAIL
                    
                    SVC --> CTRL: { user, message }
                    deactivate SVC
                    
                    CTRL --> AR: HTTP 200 { success }
                    AR --> AC: 200 OK
                    deactivate CTRL
                    deactivate AR
                    AC --> UI: resolve(data)
                    deactivate AC
                    
                    UI --> U: "Email reenviado.\nRevisa tu bandeja"
                end
            end
        else #LightGreen Email disponible
            note right of SVC: Usuario NO existe:\nregistro normal
            SVC -> SVC: bcrypt.hash(password, 12)
            SVC -> SVC: crypto.randomBytes(32)
            
            SVC -> DB: User.save()
            activate DB
            note right of DB: Incluye:\nverificationTokenExpiry\nregistrationAttempts=0
            DB --> SVC: newUser
            deactivate DB
            
            SVC ->> EMAIL: sendConfirmationEmail()
            activate EMAIL
            note right of EMAIL: Async: envía link\ncon token (expira 24h)
            EMAIL --> SVC: OK
            deactivate EMAIL
            
            SVC --> CTRL: { user, message }
            deactivate SVC
            
            CTRL --> AR: HTTP 201 { success, user }
            AR --> AC: 201 Created
            deactivate CTRL
            deactivate AR
            AC --> UI: resolve(data)
            deactivate AC
            
            UI --> U: "Cuenta creada.\nRevisa tu email"
            note right of UI #LightGreen: Muestra botón\n"Reenviar email"
        end
    end
end

deactivate UI

' ============================================
' REENVÍO DE EMAIL
' ============================================
== Reenvío de Email (Opcional) ==

U -> UI: Click "Resend email"
activate UI
UI -> AC: resendConfirmation()
activate AC

AC -> AR: POST /auth/send-confirmation
activate AR
AR -> CTRL: sendConfirmation()
activate CTRL

CTRL -> SVC: resendConfirmationEmail()
activate SVC

SVC -> DB: findOne + update token
activate DB
DB --> SVC: OK
deactivate DB

SVC ->> EMAIL: sendConfirmationEmail()
activate EMAIL
EMAIL --> SVC: OK
deactivate EMAIL

SVC --> CTRL: { message }
deactivate SVC
CTRL --> AR: HTTP 200
AR --> AC: OK
deactivate CTRL
deactivate AR
AC --> UI: resolve
deactivate AC
UI --> U: "Email reenviado"

deactivate UI

' ============================================
' LIMPIEZA AUTOMÁTICA
' ============================================
== Limpieza Automática (Background) ==

note over DB #LightCyan
  **Sistema de Limpieza:**
  • Índice TTL MongoDB: elimina usuarios no verificados tras 48h
  • Tarea programada: se ejecuta cada 6 horas
  • Limpieza inicial: al arrancar servidor
  
  **Protección contra suplantación:**
  • Usuarios no verificados expiran en 24-48h
  • Máximo 3 intentos de verificación
  • Email legítimo se libera automáticamente
end note

note over U, EMAIL #FFFFCC
  **Continúa en:** 02-confirmacion-cuenta.puml
end note

@enduml
