@startuml TFG_Registro_Usuario_Frontend_Backend
' =====================================================
' Diagrama de Secuencia (PlantUML) - Registro de Usuario
' Basado en flujo Frontend (Register.jsx) + Backend real
' =====================================================
!pragma teoz true
!theme plain

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam noteFontSize 9
skinparam participantFontSize 10
skinparam sequenceArrowFontSize 9

title Registro de nuevo Usuario (UI 3 pasos + API /auth/register)\nTFG - Sistema de Gestión de CVs

actor "Usuario" as U
boundary "RegisterPage\n(Register.jsx)" as UI
control "AuthApi\n(api/auth.js)" as API
control "AxiosClient\n(api/axios.js)" as HTTP
participant "<<System>>\nBackend API\n(Express)" as BE
control "AuthController\n(src/controllers/auth.controller.js)" as CTRL
control "Validators\n(src/utils/validators.js)" as VAL
control "AuthService\n(src/services/auth.service.js)" as SVC
entity "UserModel\n(src/models/user.model.js)" as USER
control "EmailService\n(src/services/email.service.js)" as MAIL
participant "Brevo SMTP API\n(api.brevo.com)" as BREVO

== Paso 0: Acceso a la pantalla ==
U -> UI: GET /register (navegación)
activate UI
UI --> U: Renderiza Stepper (Paso 1)

== Paso 1: Username y Rol ==
U -> UI: Click "Next"\n(username, role)
UI -> UI: Validar Paso 1
alt [username vacío o length < 3]
  UI --> U: Mostrar error (inline)
else [role no seleccionado]
  UI --> U: Mostrar error (inline)
else [OK]
  UI -> UI: setStep(2)
end

== Paso 2: Contraseña ==
U -> UI: Click "Next"\n(password, confirmPassword)
UI -> UI: Validar Paso 2
alt [password no cumple reglas UI]
  note right of UI
    Reglas UI (frontend):
    - Longitud >= 8
    - 1 mayúscula, 1 minúscula
    - 1 número, 1 carácter especial
  end note
  UI --> U: Mostrar error (inline)
else [password != confirmPassword]
  UI --> U: Mostrar error (inline)
else [OK]
  UI -> UI: setStep(3)
end

== Paso 3: Email y envío a backend ==
U -> UI: Click "Create account"\n(email)
UI -> UI: Validar email (frontend)
alt [email inválido]
  UI --> U: Mostrar error (inline)
else [OK]
  UI -> UI: setLoading(true)

  note over UI
    Payload frontend observado:
    - email
    - username
    - role ∈ {org_admin, employee}
    - password
    - name := username
  end note

  UI -> API: register(payload)
  activate API
  API -> HTTP: post('/auth/register', payload)
  activate HTTP

  note over HTTP
    Interceptor Axios:
    - Si no existe localStorage.token, no añade Authorization.
  end note

  HTTP -> BE: HTTP POST /auth/register\nBody { email, name, password, role }
  activate BE
  BE -> CTRL: register(req,res)
  activate CTRL

  CTRL -> VAL: validateRegistrationData(email, name, password)
  activate VAL
  alt [datos inválidos (backend)]
    note right of VAL
      validators.js:
      - email formato básico
      - password length >= 6
    end note
    VAL --> CTRL: throw Error\n(MISSING_REQUIRED_FIELDS, INVALID_EMAIL_FORMAT, PASSWORD_TOO_SHORT)
    deactivate VAL
    CTRL -> BE: responseHandler.handleError(error)
    CTRL --> BE: HTTP 400\n{ success:false, error:"..." }
    deactivate CTRL
    BE --> HTTP: 400 Bad Request
    deactivate BE
    HTTP --> API: reject(error)
    deactivate HTTP
    API --> UI: reject(error)
    deactivate API
    UI -> UI: setError(err.response.data.error)
    UI -> UI: setLoading(false)
    UI --> U: Mostrar error backend
  else [OK]
    VAL --> CTRL: OK
    deactivate VAL

    CTRL -> SVC: register({ email, name, password, role })
    activate SVC

    SVC -> USER: findOne(email.toLowerCase())
    activate USER
    USER --> SVC: existingUser | null
    deactivate USER

    alt [usuario ya existe]
      SVC --> CTRL: throw Error('USER_ALREADY_EXISTS')
      deactivate SVC
      CTRL -> BE: responseHandler.handleError(error)
      CTRL --> BE: HTTP 409\n{ success:false, error:"Este email ya está registrado" }
      deactivate CTRL
      BE --> HTTP: 409 Conflict
      deactivate BE
      HTTP --> API: reject(error)
      deactivate HTTP
      API --> UI: reject(error)
      deactivate API
      UI -> UI: setError("Este email ya está registrado")
      UI -> UI: setLoading(false)
      UI --> U: Mostrar error backend
    else [nuevo usuario]
      SVC -> SVC: bcrypt.hash(password, 12)
      SVC -> SVC: confirmationToken = randomBytes(32).hex
      SVC -> SVC: confirmationTokenExpiry = now + 24h
      SVC -> USER: new User(...).save()\n(isConfirmed=false)
      activate USER
      USER --> SVC: newUser (persistido)
      deactivate USER

      SVC -> SVC: confirmLink = BACKEND_URL + '/auth/confirm?token=...'

      SVC -> MAIL: sendConfirmationEmail(email, name, confirmLink)
      activate MAIL
      MAIL -> BREVO: HTTP POST /v3/smtp/email
      activate BREVO
      alt [Brevo OK]
        BREVO --> MAIL: 2xx + { messageId }
      else [Brevo error]
        BREVO --> MAIL: non-2xx
        note right of MAIL
          En auth.service.js el error se captura\n(no aborta el registro).
        end note
      end
      deactivate BREVO
      MAIL --> SVC: return / throw (capturado en servicio)
      deactivate MAIL

      SVC --> CTRL: { user:{id,email,name}, message }
      deactivate SVC

      CTRL --> BE: HTTP 201\n{ success:true, user, message }
      deactivate CTRL
      BE --> HTTP: 201 Created
      deactivate BE
      HTTP --> API: resolve(response)
      deactivate HTTP
      API --> UI: resolve(response.data)
      deactivate API

      UI -> UI: setRegistered(true)
      UI -> UI: setLoading(false)
      UI --> U: Mostrar mensaje:\n"Usuario registrado. Revisa tu email..."

      note right of UI
        Postcondición (frontend):
        - No se persiste token (no hay sesión)
        - El usuario debe confirmar email\n  y luego hacer login
      end note
    end
  end
end

deactivate UI
@enduml
