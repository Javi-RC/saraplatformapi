@startuml Diagrama_Secuencia_Registro_Usuario
' ============================================
' CONFIGURACIÓN PARA EVITAR CORTE VERTICAL
' ============================================
!pragma teoz true
scale max 4096 width
scale max 8192 height

!theme plain
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam noteFontSize 9
skinparam participantFontSize 10
skinparam sequenceGroupBorderColor #666666
skinparam sequenceArrowFontSize 9
skinparam noteBorderColor #999999
skinparam sequenceLifeLineBorderColor #888888

title Diagrama de Secuencia - Registro y Confirmación de Usuario\n(TFG - Sistema de Gestión de CVs)

' ============================================
' ACTORES Y PARTICIPANTES
' ============================================
actor Usuario as U #LightBlue
participant "<<Frontend>>\nRegister.jsx\n(Stepper 3 pasos)" as UI #LightGreen
participant "<<Frontend>>\nAuthContext\n/API Client" as AC #LightGreen
participant "<<Backend>>\nauth.routes.js\n/auth/*" as AR #LightYellow
participant "<<Backend>>\nauth.controller.js" as CTRL #LightYellow
participant "<<Backend>>\nvalidators.js" as VAL #Orange
participant "<<Backend>>\nauth.service.js" as SVC #LightYellow
participant "<<Database>>\nUser Model\n(MongoDB)" as DB #LightCoral
participant "<<External>>\nEmailService\n(Brevo API)" as EMAIL #LightPink

' ============================================
' FASE 1: REGISTRO DE USUARIO
' ============================================
== FASE 1: Proceso de Registro ==

U -> UI: Accede a /register
activate UI
UI --> U: Muestra formulario\n(Stepper Paso 1: username, role)

note over UI #LightCyan
  **Validación Cliente - Paso 1:**
  • username ≥ 3 caracteres
  • role requerido: "employee" | "org_admin"
end note

U -> UI: Completa Paso 1\n(username, role)
UI -> UI: Valida datos Paso 1

alt #LightGreen Validación Paso 1 OK
    UI --> U: Avanza a Paso 2\n(password, confirmPassword)
else #Pink Validación Paso 1 FALLA
    UI --> U: Muestra error inline\n"Username mínimo 3 caracteres"
    note right of UI #FFCCCC: No se navega.\nUsuario corrige datos.
end

note over UI #LightCyan
  **Validación Cliente - Paso 2:**
  • Password ≥ 8 caracteres
  • Al menos 1 mayúscula
  • Al menos 1 minúscula
  • Al menos 1 número
  • Al menos 1 carácter especial
  • confirmPassword === password
end note

U -> UI: Completa Paso 2\n(password, confirmPassword)
UI -> UI: Valida datos Paso 2

alt #LightGreen Validación Paso 2 OK
    UI --> U: Avanza a Paso 3\n(email, name)
else #Pink Validación Paso 2 FALLA
    UI --> U: Muestra error inline\n"Password no cumple requisitos"
end

note over UI #LightCyan
  **Validación Cliente - Paso 3:**
  • Email: regex \\S+@\\S+\\.\\S+
  • Name requerido
end note

U -> UI: Completa Paso 3\n(email, name)
UI -> UI: Valida datos Paso 3

alt #LightGreen Validación Paso 3 OK
    
    UI -> AC: handleSubmit()
    activate AC
    
    note over AC #LightBlue
      **Request HTTP:**
      POST /auth/register
      Content-Type: application/json
      Body: { email, username, role, password, name }
    end note
    
    AC -> AR: POST /auth/register\n{ email, name, password, role }
    activate AR
    AR -> CTRL: register(req, res)
    activate CTRL
    
    CTRL -> VAL: validateRegistrationData(email, name, password)
    activate VAL
    
    alt #Pink Validación Backend FALLA
        VAL --> CTRL: throw Error('MISSING_REQUIRED_FIELDS')\n| Error('INVALID_EMAIL_FORMAT')\n| Error('PASSWORD_TOO_SHORT')
        deactivate VAL
        CTRL -> CTRL: responseHandler.handleError(error, res)
        CTRL --> AR: HTTP 400\n{ success: false, error: "mensaje" }
        AR --> AC: HTTP 400 Bad Request
        deactivate CTRL
        deactivate AR
        AC --> UI: Promise.reject(error)
        deactivate AC
        UI --> U: Muestra error:\n"Todos los campos son requeridos"\n| "Formato de email inválido"\n| "Contraseña muy corta"
        note right of UI #FFCCCC: No navega.\nMuestra error del backend.
    else #LightGreen Validación Backend OK
        VAL --> CTRL: OK (sin errores)
        deactivate VAL
        
        CTRL -> SVC: register({ email, name, password, role })
        activate SVC
        
        SVC -> DB: User.findOne({ email: email.toLowerCase() })
        activate DB
        DB --> SVC: existingUser | null
        deactivate DB
        
        alt #Pink Usuario ya existe
            SVC --> CTRL: throw Error('USER_ALREADY_EXISTS')
            deactivate SVC
            CTRL -> CTRL: responseHandler.handleError(error, res)
            CTRL --> AR: HTTP 409\n{ success: false, error: "Este email ya está registrado" }
            AR --> AC: HTTP 409 Conflict
            deactivate CTRL
            deactivate AR
            AC --> UI: Promise.reject(error)
            deactivate AC
            UI --> U: Muestra error:\n"Este email ya está registrado"
        else #LightGreen Usuario NO existe
            
            SVC -> SVC: bcrypt.hash(password, 12)
            note right of SVC: Hash seguro con salt factor 12
            
            SVC -> SVC: crypto.randomBytes(32).toString('hex')
            note right of SVC: Genera confirmationToken (64 chars hex)
            
            SVC -> SVC: confirmationTokenExpiry =\nnew Date(Date.now() + 24h)
            
            SVC -> DB: new User({\n  email,\n  name,\n  passwordHash,\n  confirmationToken,\n  confirmationTokenExpiry,\n  isConfirmed: false,\n  role\n}).save()
            activate DB
            DB --> SVC: newUser (documento guardado)
            deactivate DB
            
            SVC -> SVC: Construye confirmLink:\n${BACKEND_URL}/auth/confirm?token=${token}
            
            ' ---- ENVÍO DE EMAIL (ASÍNCRONO) ----
            SVC ->> EMAIL: sendConfirmationEmail(\n  email, name, confirmLink)
            activate EMAIL #LightPink
            note over EMAIL #LightCyan
              **Email Asíncrono:**
              • Sender: configurado en env
              • To: [{ email, name }]
              • Subject: "Confirma tu cuenta"
              • HTML: Template con botón
              • Expira en 24 horas
            end note
            EMAIL -> EMAIL: POST https://api.brevo.com/v3/smtp/email
            EMAIL --> SVC: { messageId } | Error (capturado)
            deactivate EMAIL
            
            SVC --> CTRL: {\n  user: { id, email, name },\n  message: "Usuario registrado..."\n}
            deactivate SVC
            
            CTRL -> CTRL: responseHandler.success(res, data, 201)
            
            CTRL --> AR: HTTP 201\n{\n  success: true,\n  message: "Usuario registrado...",\n  user: { id, email, name }\n}
            deactivate CTRL
            AR --> AC: HTTP 201 Created
            deactivate AR
            AC --> UI: Promise.resolve(response.data)
            deactivate AC
            
            UI --> U: Muestra mensaje éxito:\n"Account created.\nCheck your email to confirm..."
            note right of UI #LightGreen
              **Estado post-registro:**
              • Botón "Resend email" visible
              • No redirige automáticamente
              • Usuario debe confirmar vía email
            end note
            
        end
    end
    
else #Pink Validación Paso 3 FALLA
    UI --> U: Muestra error inline\n"Email inválido"
end

deactivate UI

' ============================================
' FASE 2: REENVÍO DE EMAIL DE CONFIRMACIÓN
' ============================================
== FASE 2: Reenvío de Email (Opcional) ==

U -> UI: Click "Resend confirmation email"
activate UI
UI -> AC: resendConfirmation({ email, name })
activate AC

note over AC #LightBlue
  **Request HTTP:**
  POST /auth/send-confirmation
  Body: { email, name }
end note

AC -> AR: POST /auth/send-confirmation\n{ email, name }
activate AR
AR -> CTRL: sendConfirmation(req, res)
activate CTRL

CTRL -> VAL: validateConfirmationRequest(email, name)
activate VAL

alt #Pink Validación FALLA
    VAL --> CTRL: throw Error('MISSING_EMAIL_OR_NAME')
    deactivate VAL
    CTRL --> AR: HTTP 400\n{ error: "Email y nombre son requeridos" }
    AR --> AC: HTTP 400
    deactivate AR
    deactivate CTRL
    AC --> UI: Promise.reject(error)
    deactivate AC
    UI --> U: Muestra error:\nerr.response?.data?.error
else #LightGreen Validación OK
    VAL --> CTRL: OK
    deactivate VAL
    
    CTRL -> SVC: resendConfirmationEmail(email, name)
    activate SVC
    
    SVC -> DB: User.findOne({ email })
    activate DB
    DB --> SVC: user | null
    deactivate DB
    
    alt #Pink Usuario NO encontrado
        SVC --> CTRL: throw Error('USER_NOT_FOUND')
        deactivate SVC
        CTRL --> AR: HTTP 404\n{ error: "Usuario no encontrado" }
        AR --> AC: HTTP 404
        deactivate AR
        deactivate CTRL
        AC --> UI: Promise.reject(error)
        deactivate AC
        UI --> U: Muestra error:\n"Usuario no encontrado"
    else #LightGreen Usuario encontrado
        SVC -> SVC: Genera nuevo confirmationToken
        SVC -> SVC: Actualiza confirmationTokenExpiry
        
        SVC -> DB: user.save()
        activate DB
        DB --> SVC: OK
        deactivate DB
        
        SVC ->> EMAIL: sendConfirmationEmail(email, name, confirmLink)
        activate EMAIL
        EMAIL --> SVC: OK | Error
        deactivate EMAIL
        
        SVC --> CTRL: { message: "Correo de confirmación enviado" }
        deactivate SVC
        
        CTRL --> AR: HTTP 200\n{ success: true, message: "..." }
        AR --> AC: HTTP 200
        deactivate AR
        deactivate CTRL
        AC --> UI: Promise.resolve(data)
        deactivate AC
        UI --> U: Muestra mensaje:\n"Confirmation email resent"
    end
end

deactivate UI

' ============================================
' FASE 3: CONFIRMACIÓN DE CUENTA
' ============================================
== FASE 3: Confirmación de Cuenta (via Email Link) ==

U -> U: Abre email recibido
U -> UI: Click enlace:\n/auth/confirm?token=xxx
activate UI
note right of U: Usuario clickea desde\ncliente de email

UI -> AC: Navegador accede URL
activate AC

AC -> AR: GET /auth/confirm?token=xxx
activate AR
AR -> CTRL: confirmAccount(req, res)
activate CTRL

alt #Pink Token no proporcionado
    CTRL --> AR: Redirect to:\n${FRONTEND_URL}/error?message=...
    AR --> AC: HTTP 302 Redirect
    deactivate AR
    deactivate CTRL
    AC --> UI: Redirect /error
    deactivate AC
    UI --> U: Página de error:\n"Token inválido o expirado"
else #LightGreen Token proporcionado
    CTRL -> SVC: confirmAccount(token)
    activate SVC
    
    SVC -> DB: User.findOne({\n  confirmationToken: token,\n  confirmationTokenExpiry: { $gt: Date.now() }\n})
    activate DB
    DB --> SVC: user | null
    deactivate DB
    
    alt #Pink Token inválido o expirado
        SVC --> CTRL: throw Error('INVALID_OR_EXPIRED_TOKEN')
        deactivate SVC
        CTRL --> AR: Redirect to:\n${FRONTEND_URL}/error?message=...
        AR --> AC: HTTP 302 Redirect
        deactivate AR
        deactivate CTRL
        AC --> UI: Redirect /error
        deactivate AC
        UI --> U: Página de error:\n"Invalid/expired token"
    else #LightGreen Token válido
        SVC -> SVC: user.isConfirmed = true
        SVC -> SVC: user.confirmationToken = undefined
        SVC -> SVC: user.confirmationTokenExpiry = undefined
        SVC -> SVC: user.lastLogin = new Date()
        
        SVC -> DB: user.save()
        activate DB
        DB --> SVC: OK
        deactivate DB
        
        SVC --> CTRL: user (confirmado)
        deactivate SVC
        
        CTRL -> CTRL: responseHandler.redirect(res, url)
        CTRL --> AR: Redirect to:\n${FRONTEND_URL}/login?confirmed=true
        AR --> AC: HTTP 302 Redirect
        deactivate AR
        deactivate CTRL
        AC --> UI: Redirect /login?confirmed=true
        deactivate AC
        UI --> U: Página Login con mensaje:\n"Account confirmed.\nYou can now log in."
    end
end

deactivate UI

' ============================================
' FASE 4: LOGIN
' ============================================
== FASE 4: Login del Usuario ==

U -> UI: Accede a /login
activate UI
UI --> U: Muestra formulario login

U -> UI: Ingresa email y password
UI -> AC: login({ email, password })
activate AC

note over AC #LightBlue
  **Request HTTP:**
  POST /auth/login
  Content-Type: application/json
  Body: { email, password }
end note

AC -> AR: POST /auth/login\n{ email, password }
activate AR
AR -> CTRL: login(req, res)
activate CTRL

CTRL -> VAL: validateLoginData(email, password)
activate VAL

alt #Pink Datos faltantes
    VAL --> CTRL: throw Error('MISSING_CREDENTIALS')
    deactivate VAL
    CTRL --> AR: HTTP 400\n{ error: "Email y contraseña son requeridos" }
    AR --> AC: HTTP 400
    deactivate AR
    deactivate CTRL
    AC --> UI: Promise.reject(error)
    deactivate AC
    UI --> U: Muestra error del backend
else #LightGreen Datos presentes
    VAL --> CTRL: OK
    deactivate VAL
    
    CTRL -> SVC: login({ email, password })
    activate SVC
    
    SVC -> DB: User.findOne({ email })\n.select('+passwordHash')
    activate DB
    DB --> SVC: user | null
    deactivate DB
    
    alt #Pink Usuario no existe
        SVC --> CTRL: throw Error('INVALID_CREDENTIALS')
        deactivate SVC
        CTRL --> AR: HTTP 401\n{ error: "Credenciales inválidas" }
        AR --> AC: HTTP 401
        deactivate AR
        deactivate CTRL
        AC --> UI: Promise.reject(error)
        deactivate AC
        UI --> U: Muestra error:\n"Credenciales inválidas"
    else #LightGreen Usuario existe
        
        alt #Pink Email no confirmado
            SVC --> CTRL: throw Error('EMAIL_NOT_CONFIRMED')
            deactivate SVC
            CTRL --> AR: HTTP 401\n{ error: "Confirma tu email primero" }
            AR --> AC: HTTP 401
            deactivate AR
            deactivate CTRL
            AC --> UI: Promise.reject(error)
            deactivate AC
            UI --> U: Muestra error:\n"Confirma tu email antes de iniciar sesión"
        else #LightGreen Email confirmado
            
            SVC -> SVC: user.comparePassword(password)
            note right of SVC: bcrypt.compare(password, passwordHash)
            
            alt #Pink Password incorrecto
                SVC --> CTRL: throw Error('INVALID_CREDENTIALS')
                deactivate SVC
                CTRL --> AR: HTTP 401\n{ error: "Credenciales inválidas" }
                AR --> AC: HTTP 401
                deactivate AR
                deactivate CTRL
                AC --> UI: Promise.reject(error)
                deactivate AC
                UI --> U: Muestra error:\n"Credenciales inválidas"
            else #LightGreen Password correcto
                SVC -> SVC: user.lastLogin = new Date()
                SVC -> DB: user.save()
                activate DB
                DB --> SVC: OK
                deactivate DB
                
                SVC -> SVC: generateToken(user)
                note right of SVC #LightCyan
                  **JWT Payload:**
                  {
                    userId: user._id,
                    email: user.email,
                    name: user.name,
                    role: user.role
                  }
                  Expira: 7d (configurable)
                end note
                
                SVC --> CTRL: {\n  token: "eyJhbGc...",\n  user: { id, email, name, role }\n}
                deactivate SVC
                
                CTRL --> AR: HTTP 200\n{\n  success: true,\n  message: "Login exitoso",\n  token: "...",\n  user: {...}\n}
                AR --> AC: HTTP 200
                deactivate AR
                deactivate CTRL
                
                AC -> AC: AuthContext.setSession(token, user)
                note right of AC #LightCyan
                  **localStorage:**
                  • token: JWT string
                  • user: JSON stringified
                end note
                
                AC --> UI: Promise.resolve({ token, user })
                deactivate AC
                
                alt #LightYellow role === 'unassigned'
                    UI --> U: Redirect /complete-profile
                    note right of UI: Usuario OAuth o sin rol\ndebe completar perfil
                else #LightGreen role definido
                    UI --> U: Redirect /\n(Dashboard principal)
                end
            end
        end
    end
end

deactivate UI

' ============================================
' FASE 5: CARGA DE PERFIL (AuthProvider)
' ============================================
== FASE 5: Carga de Perfil (Sesión Existente) ==

U -> UI: Navega a ruta protegida\n(con token en localStorage)
activate UI

UI -> AC: AuthProvider.loadProfile()
activate AC

note over AC #LightBlue
  **Request HTTP:**
  GET /api/profile
  Authorization: Bearer <token>
end note

AC -> AR: GET /api/profile
activate AR

AR -> AR: authMiddleware(req, res, next)
note right of AR #LightCyan
  **JWT Verification:**
  1. Extrae token del header
  2. jwt.verify(token, JWT_SECRET)
  3. Adjunta decoded a req.user
end note

alt #Pink Token inválido/expirado
    AR --> AC: HTTP 401\n{ error: "Token inválido" | "Token expirado" }
    deactivate AR
    AC -> AC: Limpia localStorage\n(token, user)
    AC --> UI: null (sin sesión)
    deactivate AC
    UI -> UI: ProtectedRoute detecta\nsin autenticación
    UI --> U: Redirect /login
else #LightGreen Token válido
    AR -> DB: User.findById(req.user.userId)
    activate DB
    DB --> AR: user
    deactivate DB
    AR --> AC: HTTP 200\n{ user: {...} }
    deactivate AR
    AC --> UI: user (perfil cargado)
    deactivate AC
    UI --> U: Muestra contenido protegido
end

deactivate UI

' ============================================
' NOTAS FINALES
' ============================================
note over U, EMAIL #FFFFCC
  **Resumen de Códigos HTTP:**
  • 200 OK: Operación exitosa
  • 201 Created: Usuario registrado
  • 302 Redirect: Confirmación de cuenta
  • 400 Bad Request: Validación fallida
  • 401 Unauthorized: Credenciales inválidas / Token inválido
  • 404 Not Found: Usuario no encontrado
  • 409 Conflict: Email duplicado
  • 500 Internal Server Error: Error del servidor
end note

note over SVC, DB #E8F5E9
  **Seguridad implementada:**
  • Passwords hasheados con bcrypt (salt 12)
  • Tokens de confirmación aleatorios (crypto)
  • JWT firmado con secreto (HS256)
  • Tokens expiran en 24h (confirmación) / 7d (sesión)
  • Email siempre en lowercase
end note

@enduml
