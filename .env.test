# Test Environment
NODE_ENV=test
PORT=3001

# Test uses in-memory MongoDB (mongodb-memory-server)
# No need to set MONGODB_URI - tests configure it automatically

EMAIL_SENDER_NAME=JaviTFG_Test
EMAIL_SENDER_EMAIL=test@example.com
BREVO_API_KEY=test_api_key
JWT_SECRET=test_secret_key_for_testing_only
JWT_EXPIRES_IN=1h
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Test OAuth credentials (mocked in tests)
GOOGLE_CLIENT_ID=test_google_client_id
GOOGLE_CLIENT_SECRET=test_google_client_secret

# Test AI key (mocked in tests)
GEMINI_API_KEY=test_gemini_api_key

# Relaxed rate limits for testing
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10000
